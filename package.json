{
  "name": "@whyparabola/cabar",
  "version": "0.1.0",
  "description": "Context-budget-aware retrieval: pick which retrieved chunks are worth the prompt tokens. Pure TypeScript, zero dependencies, no LLM calls.",
  "license": "MIT",
  "author": "Aman Jha (https://x.com/WhyParabola)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-man07/cabar.git"
  },
  "homepage": "https://github.com/e-man07/cabar#readme",
  "bugs": {
    "url": "https://github.com/e-man07/cabar/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/langchain.ts --format esm,cjs --dts --clean --external @langchain/core",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "rag",
    "retrieval",
    "context-window",
    "token-budget",
    "llm",
    "agent-memory",
    "knapsack",
    "mmr",
    "compression",
    "prompt"
  ],
  "peerDependencies": {
    "@langchain/core": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.13",
    "@types/node": "^22.10.2",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
