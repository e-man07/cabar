{
  "name": "cabar",
  "version": "0.1.0",
  "description": "Context-budget-aware retrieval: pick which retrieved chunks are worth the prompt tokens. Pure TypeScript, zero dependencies, no LLM calls.",
  "license": "MIT",
  "author": "Aman Jha (https://x.com/WhyParabola)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic.ts"
  },
  "keywords": [
    "rag",
    "retrieval",
    "context-window",
    "token-budget",
    "llm",
    "agent-memory",
    "knapsack",
    "mmr",
    "compression",
    "prompt"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
